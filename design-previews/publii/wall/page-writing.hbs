{{> head}}
{{#page}}
<main id="main">
<div class="pad head"><h1>{{title}}</h1></div>
<div class="pad page">
  <div class="maggrid">
  {{#getPosts @config.custom.writingPosts "" ""}}
    <a class="mag" href="{{url}}"><span class="pic">{{#featuredImage}}{{#if url}}<img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.card sizes.card}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" style="view-transition-name:post-{{../id}}" loading="lazy">{{/if}}{{/featuredImage}}</span><span class="kick">{{#if mainTag}}{{mainTag.name}}{{else}}{{#if tags}}{{tags.[0].name}}{{else}}Writing{{/if}}{{/if}}</span><span class="t">{{title}}</span><span class="s">{{{excerpt}}}</span><span class="meta">{{date createdAt "D MMMM YYYY"}}</span></a>
  {{/getPosts}}
  </div>
  {{#if text}}<div class="raw">{{{text}}}</div>{{/if}}
</div>
</main>
{{/page}}
{{> footer}}
