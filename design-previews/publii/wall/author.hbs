<div class="pad page post-list"><div class="rows">{{#each posts}}<a class="rw" href="{{url}}"><span class="d">{{date createdAt "D MMMM YYYY"}}</span><span class="t">{{title}}</span><span class="s">{{{excerpt}}}</span></a>{{/each}}</div></div>
</main>
{{/author}}
{{> footer}}
