{{!-- On the Writing page: the byline card. --}}
<div class="au au-a">
  {{#if @config.custom.heroImage}}<img src="{{@config.custom.heroImage}}" {{responsiveSrcSet @config.custom.heroImage}} sizes="112px" width="112" height="140" alt="{{@config.custom.heroImageAlt}}" loading="lazy">{{/if}}
  <div>
    <span class="n">{{@website.name}}</span>
    <span class="r">{{@config.custom.authorRole}}</span>
    <p>{{{@config.custom.authorBlurb}}}</p>
    {{#getPage 12}}<a class="more" href="{{url}}">More about me<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></a>{{/getPage}}
  </div>
</div>
