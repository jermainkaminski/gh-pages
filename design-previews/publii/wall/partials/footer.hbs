<footer class="close{{#is "post"}} slim{{/is}}" id="contact">
  <div class="pad in">
    {{#is "post"}}
    <div class="author-card">
      {{#if @config.custom.heroImage}}<img src="{{@config.custom.heroImage}}" {{responsiveSrcSet @config.custom.heroImage}} sizes="112px" width="112" height="112" alt="{{@config.custom.heroImageAlt}}" loading="lazy">{{/if}}
      <div>
        <span class="n">{{@website.name}}</span>
        <p>{{{@config.custom.authorBlurb}}}</p>
        <nav aria-label="Author">{{#getPage 12}}<a href="{{url}}">About</a>{{/getPage}}{{#getPage 24}}<a href="{{url}}">All writing</a>{{/getPage}}<a href="{{@config.custom.linkedin}}">LinkedIn</a><a href="{{@config.custom.bluesky}}">Bluesky</a><a class="mailto" data-u="{{@config.custom.mailUser1}}" data-d="{{@config.custom.mailDomain1}}" href="#contact">Email</a></nav>
      </div>
    </div>
    {{else}}
    <h2>Let’s <em>work together.</em></h2>
    <div class="routes">
      <div><p>Research collaboration:</p><div class="mail"><a class="mailto" data-u="{{@config.custom.mailUser1}}" data-d="{{@config.custom.mailDomain1}}" href="#contact">{{@config.custom.mailUser1}}<span class="at"> at </span>{{@config.custom.mailDomain1}}</a></div></div>
      <div><p>Speaking, workshops and advisory:</p><div class="mail"><a class="mailto" data-u="{{@config.custom.mailUser2}}" data-d="{{@config.custom.mailDomain2}}" href="#contact">{{@config.custom.mailUser2}}<span class="at"> at </span>{{@config.custom.mailDomain2}}</a></div></div>
    </div>
    {{/is}}
    <div class="colophon">
      <span>{{@website.name}}</span>
      <nav aria-label="Elsewhere">{{#getPage 24}}<a href="{{url}}">Writing</a>{{/getPage}}<a href="{{@config.custom.linkedin}}">LinkedIn</a><a href="{{@config.custom.bluesky}}">Bluesky</a>{{#getPage 23}}<a href="{{url}}">Privacy</a>{{/getPage}}</nav>
      <span class="upd" data-updated></span>
    </div>
  </div>
</footer>
<script src="{{js "wall.js"}}" defer></script>
{{{@footerCustomCode}}}
{{{publiiFooter}}}
</body>
</html>
