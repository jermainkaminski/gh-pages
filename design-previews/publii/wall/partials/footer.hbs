<footer class="close{{#is "post"}} slim{{/is}}{{#checkIf page.id '==' 24}} slim{{/checkIf}}" id="contact">
  <div class="pad in">
    {{#is "post"}}{{> author-card}}{{> routes}}{{/is}}
    {{#is "page"}}{{#checkIf page.id '==' 24}}{{> author-byline}}{{> routes}}{{else}}{{> signoff}}{{/checkIf}}{{/is}}
    {{#is "index"}}{{> signoff}}{{/is}}
    {{#is "404"}}{{> signoff}}{{/is}}
    {{#is "tag"}}{{> signoff}}{{/is}}
    <div class="colophon">
      <span class="sig">{{> logo}}{{@website.name}}</span>
      <nav aria-label="Elsewhere">{{#getPage 24}}<a href="{{url}}">Writing</a>{{/getPage}}<a href="{{@config.custom.linkedin}}">LinkedIn</a><a href="{{@config.custom.bluesky}}">Bluesky</a>{{#getPage 23}}<a href="{{url}}">Privacy</a>{{/getPage}}</nav>
      <span class="upd" data-updated></span>
    </div>
  </div>
</footer>
<script src="{{js "wall.js"}}" defer></script>
{{{@footerCustomCode}}}
{{{publiiFooter}}}
</body>
</html>
