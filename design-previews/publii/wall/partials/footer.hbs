<footer class="close{{#is "post"}} slim{{/is}}{{#checkIf page.id '==' 24}} slim{{/checkIf}}" id="contact">
  <div class="pad in">
    {{#is "post"}}
    {{> author-card}}
    {{else}}{{#checkIf page.id '==' 24}}
    {{> author-byline}}
    {{else}}
    <h2>Let’s <em>work together.</em></h2>
    <div class="routes">
      <div><p>Research collaboration:</p><div class="mail"><a class="mailto" data-u="{{@config.custom.mailUser1}}" data-d="{{@config.custom.mailDomain1}}" href="#contact">{{@config.custom.mailUser1}}<span class="at"> at </span>{{@config.custom.mailDomain1}}</a></div></div>
      <div><p>Speaking, workshops and advisory:</p><div class="mail"><a class="mailto" data-u="{{@config.custom.mailUser2}}" data-d="{{@config.custom.mailDomain2}}" href="#contact">{{@config.custom.mailUser2}}<span class="at"> at </span>{{@config.custom.mailDomain2}}</a></div></div>
    </div>
    {{/checkIf}}{{/is}}
    <div class="colophon">
      <span class="sig"><svg class="logo" viewBox="0 0 100 100" aria-hidden="true"><path class="f1" d="M50 50L50 6L56.12 35.22ZM50 50L94 50L64.78 56.12ZM50 50L50 94L43.88 64.78ZM50 50L6 50L35.22 43.88Z"/><path class="f2" d="M50 50L50 6L43.88 35.22ZM50 50L94 50L64.78 43.88ZM50 50L50 94L56.12 64.78ZM50 50L6 50L35.22 56.12Z"/><path class="f3" d="M50 50L72.63 27.37L64.78 43.88ZM50 50L72.63 72.63L56.12 64.78ZM50 50L27.37 72.63L35.22 56.12ZM50 50L27.37 27.37L43.88 35.22Z"/><path class="f4" d="M50 50L72.63 27.37L56.12 35.22ZM50 50L72.63 72.63L64.78 56.12ZM50 50L27.37 72.63L43.88 64.78ZM50 50L27.37 27.37L35.22 43.88Z"/></svg>{{@website.name}}</span>
      <nav aria-label="Elsewhere">{{#getPage 24}}<a href="{{url}}">Writing</a>{{/getPage}}<a href="{{@config.custom.linkedin}}">LinkedIn</a><a href="{{@config.custom.bluesky}}">Bluesky</a>{{#getPage 23}}<a href="{{url}}">Privacy</a>{{/getPage}}</nav>
      <span class="upd" data-updated></span>
    </div>
  </div>
</footer>
<script src="{{js "wall.js"}}" defer></script>
{{{@footerCustomCode}}}
{{{publiiFooter}}}
</body>
</html>
