{{!-- One post as a card: image, title, date, blurb. Used on the home page and the Writing page. --}}
<a class="card" href="{{url}}"><span class="pic">{{#featuredImage}}{{#if url}}<img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.card sizes.card}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" style="view-transition-name:post-{{../id}}" loading="lazy">{{/if}}{{/featuredImage}}</span><span class="t">{{title}}</span><span class="d">{{date createdAt "D MMMM YYYY"}}</span><span class="s">{{{excerpt}}}</span></a>
