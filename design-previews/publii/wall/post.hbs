{{> head}}
{{#post}}
<main id="main">
<div class="runhead" aria-hidden="true">{{#getPage 24}}<a class="back" href="{{url}}" tabindex="-1">← Writing</a>{{/getPage}}<span class="t">{{title}}</span></div>
<div class="pad head post-head">{{#getPage 24}}<div class="up"><a class="back" href="{{url}}">← Writing</a></div>{{/getPage}}<span class="d">{{date createdAt "D MMMM YYYY"}}</span><h1>{{title}}</h1></div>
{{#featuredImage}}{{#if url}}
<div class="pad"><figure class="band post"><img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" style="view-transition-name:post-{{../id}}">{{#if caption}}<figcaption class="note">{{{caption}}}</figcaption>{{/if}}</figure></div>
{{/if}}{{/featuredImage}}
<div class="pad page{{#each tags}}{{#checkIf slug '==' 'essay'}} is-essay{{/checkIf}}{{/each}}"><article class="body article">{{{text}}}
<div class="post-end">
<ul class="kw" aria-label="Keywords">{{#each tags}}{{#checkIf slug '==' 'essay'}}{{else}}{{#checkIf slug '==' 'news'}}{{else}}{{#checkIf slug '==' 'editors-picks'}}{{else}}<li><a href="{{url}}">{{name}}</a></li>{{/checkIf}}{{/checkIf}}{{/checkIf}}{{/each}}</ul>
{{> share}}
</div>
{{#checkIfAny ../previousPost ../nextPost}}<nav class="pn" aria-label="More writing">{{#../previousPost}}<a class="prev" href="{{url}}"><span class="lbl">← Previous</span><span class="t">{{title}}</span></a>{{/../previousPost}}{{#../nextPost}}<a class="next" href="{{url}}"><span class="lbl">Next →</span><span class="t">{{title}}</span></a>{{/../nextPost}}</nav>{{/checkIfAny}}
</article></div>
</main>
{{/post}}
{{> footer}}
