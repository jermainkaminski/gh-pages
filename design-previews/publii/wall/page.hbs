{{> head}}
{{#page}}
<main id="main">
{{#checkIf id '==' 12}}
{{!-- About: the photograph beside the text; the page greets instead of announcing itself --}}
<div class="pad head"><h1>Welcome!</h1></div>
<div class="pad page standing">
  {{#featuredImage}}{{#if url}}<figure><img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.half sizes.half}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}">{{#if caption}}<figcaption class="note">{{{caption}}}</figcaption>{{/if}}</figure>{{/if}}{{/featuredImage}}
  <div class="body about-raw">{{{text}}}</div>
</div>
{{else}}
<div class="pad head"><h1>{{title}}</h1>{{> page-lead}}</div>
{{#checkIf id '==' 11}}{{else}}<div class="pad">{{> band}}</div>{{/checkIf}}
<div class="pad page sub">
  {{#checkIf id '==' 11}}<section class="part"><h2>Three pillars of my current research</h2><div class="body">{{> pillars}}</div></section>{{> band}}{{/checkIf}}
  {{#checkIf id '==' 15}}<script src="{{js "citations.js"}}" defer></script>{{/checkIf}}
  <div class="raw"{{#checkIf id '==' 15}} data-cite{{/checkIf}}{{#checkIf id '==' 25}} data-cite{{/checkIf}}>{{{text}}}</div>
</div>
{{/checkIf}}
</main>
{{/page}}
{{> footer}}
