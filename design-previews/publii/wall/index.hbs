{{> head}}
<main id="main">
<div class="pad">
  <div class="stage" id="top">
    <div class="say">
      <h1>{{{@config.custom.heroText}}}</h1>
      <dl class="facts">
        <div><dt>At</dt><dd>{{{@config.custom.factBased}}}</dd></div>
        <div><dt>Research</dt><dd>{{{@config.custom.factFocus}}}</dd></div>
        <div><dt>Co-founded</dt><dd>{{{@config.custom.factCofounded}}}</dd></div>
        <div><dt>Advisor</dt><dd>{{{@config.custom.factAdvisor}}}</dd></div>
      </dl>
    </div>
    {{#if @config.custom.heroImage}}
    <figure class="portrait"><img src="{{@config.custom.heroImage}}" {{responsiveImageAttributes @config.custom.heroImage}} {{imageDimensions @config.custom.heroImage}} fetchpriority="high" alt="{{@config.custom.heroImageAlt}}"><a class="badge-m" href="{{@config.custom.badgeLink}}"><img src="{{@website.assetsUrl}}/img/40under40logo.jpg" width="271" height="459" alt="Poets&amp;Quants Best 40 Under 40 Professors"></a><figcaption class="note">{{{@config.custom.heroImageNote}}}</figcaption></figure>
    {{/if}}
  </div>
</div>

<section class="sec pad blog">
  <div class="bh"><h2 class="sec-h">Latest writing</h2>{{#getPage 24}}<a class="more" href="{{url}}">All writing</a>{{/getPage}}</div>
  <div class="cards">{{#getPosts @config.custom.writingPosts "" ""}}{{> postcard}}{{/getPosts}}</div>
</section>

<section class="sec pad" id="pillars"><h2 class="sec-h">Three pillars of current research</h2>{{> pillars}}</section>

<section class="pad" id="teaching">
  <div class="teach">
    {{#getPage 18}}{{#featuredImage}}{{#if url}}<figure><img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" loading="lazy"><figcaption class="note">{{#if caption}}{{{caption}}}{{else}}<b>MBA teaching</b>Maastricht University{{/if}}</figcaption></figure>{{/if}}{{/featuredImage}}{{/getPage}}
    <div>
      <h2 class="sec-h" style="margin-bottom:28px">Teaching</h2>
      <dl class="nums">
        <div><dt>Commercializing Science and Technology</dt><dd>9.6<small> / 10</small></dd></div>
        <div><dt>Technology Entrepreneurship</dt><dd>9.4<small> / 10</small></dd></div>
        <div><dt>Digital Entrepreneurship</dt><dd>9.2<small> / 10</small></dd></div>
        <div><dt>Entrepreneurship and New Business Development</dt><dd>5.0<small> / 5</small></dd></div>
      </dl>
      {{#getPage 18}}<a class="more" href="{{url}}">Courses and teaching statement</a>{{/getPage}}
    </div>
  </div>
</section>

<section class="sec pad duo">
<div id="news">
  <div class="bh"><h2 class="sec-h">In the news</h2>{{#getPage 25}}<a class="more" href="{{url}}">All coverage</a>{{/getPage}}</div>
  <div class="sched news">
    <a href="https://github.blog/news-insights/policy-news-and-insights/how-researchers-are-using-github-innovation-graph-data-to-reveal-the-digital-complexity-of-nations/"><span class="o">GitHub Blog</span><span class="t">How researchers are using GitHub Innovation Graph data to reveal the “digital complexity” of nations</span><span>2026</span></a>
    <a href="{{@config.custom.badgeLink}}"><span class="o">Poets&amp;Quants</span><span class="t">Best 40 Under 40 MBA Professors</span><span>2024</span></a>
    <a href="https://www.einsteintelescope-emr.eu/en/2024/07/04/the-entrepreneurial-side-of-fundamental-research/"><span class="o">Einstein Telescope</span><span class="t">The entrepreneurial side of fundamental research</span><span>2024</span></a>
  </div>
</div>

<div id="events">
  <div class="bh"><h2 class="sec-h">Recent and upcoming</h2></div>
  <div class="sched">
    <a href="https://causalscience.org"><span>Causal Data Science Meeting 2026</span><span>Online · Nov 2026</span></a>
    <a href="https://www-eur.cvent.com/c/calendar/8b04e847-c70e-4051-9367-ac0c991ebffe"><span>NATO STO Symposium on Autonomy, Space, and AI</span><span>Brussels · Nov 2026</span></a>
    <a href="https://www.rbfc.eu"><span>Research in Behavioral Finance Conference</span><span>Amsterdam · Sep 2026</span></a>
    <a href="https://events.aom.org/events/aom-2026/session/qoG_QwylktF7p7uQxZdfj"><span>Academy of Management 2026</span><span>Philadelphia · Jul–Aug 2026</span></a>
    <a href="https://www.ip.mpg.de/en/the-institute/all-events/innovation-entrepreneurship-seminar-how-causal-graphs-can-improve-strategic-decision-making.html"><span>Innovation &amp; Entrepreneurship Seminar</span><span>Max Planck · Jul 2026</span></a>
    <a href="https://cimlconference.imtlucca.it"><span>Frontiers of Causal Inference and ML</span><span>IMT Lucca · Apr 2026</span></a>
  </div>
</div>
</section>
</main>
{{> footer}}
