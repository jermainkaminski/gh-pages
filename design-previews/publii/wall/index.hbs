{{> head}}
<main id="main">
<div class="pad">
  <div class="stage" id="top">
    <div class="say">
      <h1>{{{@config.custom.heroText}}}</h1>
      <dl class="facts">
        <div><dt>Based</dt><dd>{{{@config.custom.factBased}}}</dd></div>
        <div><dt>Focus</dt><dd>{{{@config.custom.factFocus}}}</dd></div>
        <div><dt>Co-founded</dt><dd>{{{@config.custom.factCofounded}}}</dd></div>
        <div><dt>Advisor</dt><dd>{{{@config.custom.factAdvisor}}}</dd></div>
      </dl>
    </div>
    {{#if @config.custom.heroImage}}
    <figure class="portrait"><img src="{{@config.custom.heroImage}}" {{responsiveImageAttributes @config.custom.heroImage}} {{imageDimensions @config.custom.heroImage}} fetchpriority="high" alt="{{@config.custom.heroImageAlt}}"><figcaption class="note">{{{@config.custom.heroImageNote}}}</figcaption></figure>
    {{/if}}
  </div>
</div>

<section class="sec pad blog">
  <div class="bh"><h2 class="sec-h">Latest writing</h2>{{#getPage 24}}<a class="more" href="{{url}}">All writing</a>{{/getPage}}</div>
  <div class="cards">{{#getPosts @config.custom.writingPosts "" ""}}{{> postcard}}{{/getPosts}}</div>
</section>

<section class="sec pad" id="pillars"><h2 class="sec-h">Three pillars of current research</h2>{{> pillars}}</section>

<section class="sec pad" id="work">
  <h2 class="sec-h">Selected work</h2>
  <ul class="work">
    <li><a href="https://doi.org/10.1016/j.respol.2026.105422"><span class="t">The software complexity of nations</span><span class="y">2026 · Research Policy</span><span class="s">With Juhász, Wachs and Hidalgo. Economic complexity, measured through the software countries produce.</span></a></li>
    <li><a href="https://www.sciencedirect.com/science/article/abs/pii/S0883902618308619"><span class="t">Launching for success</span><span class="y">2021 · Journal of Business Venturing</span><span class="s">How psychological distance and mental simulation shape crowdfunding decisions.</span></a></li>
    <li><a href="https://link.springer.com/content/pdf/10.1007/s11187-019-00218-w.pdf"><span class="t">Predicting outcomes in crowdfunding</span><span class="y">2020 · Small Business Economics</span><span class="s">An early multimodal classifier for venture outcomes, reading text, images and language.</span></a></li>
    <li><a href="https://hbr.org/2018/04/what-40-years-of-research-reveals-about-the-difference-between-disruptive-and-radical-innovation"><span class="t">What 40 years of research reveals</span><span class="y">2018 · Harvard Business Review</span><span class="s">The difference between disruptive and radical innovation, drawn from topic models.</span></a></li>
    <li><a href="https://causalscience.org"><span class="t">Causal Data Science Meeting</span><span class="y">2020– · Co-founded with Paul Hünermund</span><span class="s">Keynotes have included Guido Imbens, Susan Athey and Judea Pearl.</span></a></li>
    <li><a href="https://doi.org/10.7910/DVN/T4HBA3"><span class="t">Moviegalaxies</span><span class="y">2012– · Harvard Dataverse</span><span class="s">Social networks in movies, open on Harvard Dataverse. An Awwwards Honorable Mention along the way.</span></a></li>
  </ul>
</section>

{{#getPage 11}}{{#featuredImage}}{{#if url}}
<div class="pad">
  <figure class="river">
    <img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" loading="lazy">
    <figcaption><span>Charles River, seen from the MIT sailing dock.</span><span>Visiting researcher, MIT Sloan and MIT Media Lab</span></figcaption>
  </figure>
</div>
{{/if}}{{/featuredImage}}{{/getPage}}

<section class="sec pad" id="about">
  <div class="about">
    <p class="big">My work brings together causal inference, language and vision to study how text, images and behaviour change financing and innovation outcomes.</p>
    <div>
      <p>I earned my PhD (summa cum laude) at RWTH Aachen in 2019 and was a visiting researcher with Thomas Malone and Peter Gloor at MIT’s Center for Collective Intelligence, and with César Hidalgo at the MIT Media Lab.</p>
      <p>Before academia I worked in central marketing at Porsche, in executive consulting, and on data analytics in soccer for a Bundesliga club. My research with colleagues is cited by the OECD and the European Commission’s Joint Research Centre.</p>
      {{#getPage 12}}<a class="more" style="margin:0" href="{{url}}">More about me</a>{{/getPage}}
    </div>
  </div>
</section>

<section class="pad" id="teaching">
  <div class="teach">
    {{#getPage 18}}{{#featuredImage}}{{#if url}}<figure><img src="{{url}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}{{/if}} width="{{width}}" height="{{height}}" alt="{{alt}}" loading="lazy">{{#if caption}}<figcaption class="note">{{{caption}}}</figcaption>{{/if}}</figure>{{/if}}{{/featuredImage}}{{/getPage}}
    <div>
      <h2 class="sec-h" style="margin-bottom:28px">Teaching</h2>
      <dl class="nums">
        <div><dt>Commercializing Science and Technology</dt><dd>9.6<small> / 10</small></dd></div>
        <div><dt>Technology Entrepreneurship</dt><dd>9.4<small> / 10</small></dd></div>
        <div><dt>Digital Entrepreneurship</dt><dd>9.2<small> / 10</small></dd></div>
        <div><dt>Entrepreneurship and New Business Development</dt><dd>5.0<small> / 5</small></dd></div>
      </dl>
      {{#getPage 18}}<a class="more" href="{{url}}">Courses and teaching statement</a>{{/getPage}}
    </div>
  </div>
</section>

<section class="sec pad" id="collab"><h2 class="sec-h">Work with me</h2>
  <div class="collab">
    <div><h3>Research collaboration</h3><p>Causal inference, machine learning, and text and image data on entrepreneurship, strategy and innovation. I’m open to co-authoring, to joint data projects, and to companies and public bodies with a question that deserves a proper answer.</p><a class="more mailto" href="#contact" data-u="{{@config.custom.mailUser1}}" data-d="{{@config.custom.mailDomain1}}">Write to me</a></div>
    <div><h3>Speaking, workshops and advisory</h3><p>Keynotes and executive workshops on causal thinking and AI in strategy, and advisory for teams that need to know what their data can and cannot tell them.</p>{{#getPage 17}}<a class="more" href="{{url}}">Speaking and advisory</a>{{/getPage}}</div>
    <div><h3>Students</h3><p>I supervise PhD, master’s and honours students at Maastricht, and I’m always glad to hear from prospective PhD candidates with a causal or machine-learning question in mind.</p>{{#getPage 16}}<a class="more" href="{{url}}">Working with students</a>{{/getPage}}</div>
  </div>
</section>

